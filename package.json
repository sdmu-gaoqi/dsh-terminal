{
  "name": "@wagq/dsh-terminal",
  "version": "0.4.0",
  "description": "把电脑终端接到 DSH 左侧栏：真 PTY + xterm 渲染，多窗口、命令执行、重命名。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "prepare": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "verify:style": "node scripts/verify-style.mjs",
    "verify:umd": "node scripts/verify-umd.mjs",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "check": "node scripts/build.mjs && node scripts/verify-style.mjs && node scripts/verify-umd.mjs && node scripts/verify-e2e.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.2.0-beta.15"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
